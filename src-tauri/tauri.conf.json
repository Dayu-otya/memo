{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "メモ帳",
  "mainBinaryName": "メモ帳",
  "version": "2.0.1",
  "identifier": "com.dayuotya.memo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Dayu-otya",
    "copyright": "MIT License",
    "shortDescription": "使いやすいメモ帳アプリ",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "languages": ["Japanese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzRjQ1QUQxQTRDQzM4MTgKUldRWU9NeWswVnIwSThQbXpNbkdNV29xR2IxOHF5ay94MG00SS9kYkZ4WUo5TmpyRzN0SGJTOGQK",
      "endpoints": ["https://github.com/Dayu-otya/memo/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
